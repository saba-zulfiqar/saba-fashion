PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/saba-fashion
JWT_SECRET=replace-with-a-long-random-secret-string-please-change-me
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
# ^ Comma-separated list of frontend origins allowed by CORS (never use * with
#   credentials: true). Add your deployed frontend URL here too, e.g.
#   CLIENT_ORIGIN=https://shop.example.com

# Stripe (optional). Without STRIPE_SECRET_KEY the "Card" option shows a
# clear "not configured" message and Cash on Delivery still works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
